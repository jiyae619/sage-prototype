# Copy the KEYS you need into .env.local (gitignored via *.local). Never commit values.

# --- MCP server (netlify/functions/mcp) ---
# Static bearer token that Purple must send as `Authorization: Bearer <token>`.
# Generate one:   openssl rand -hex 32
# Local dev:      put it in .env.local; `netlify dev` loads it.
# Production:     Netlify → Site configuration → Environment variables → MCP_BEARER_TOKEN
#                 (or: netlify env:set MCP_BEARER_TOKEN "<value>" --context production)
# The endpoint returns 503 if this is unset — it never runs open.
MCP_BEARER_TOKEN=
