{
  "description": "Keeps the review gate honest: agents cannot edit the gate, and a session cannot end on failing checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hooks/guard-gate-integrity.mjs\"",
            "timeoutSec": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hooks/stop-gate.mjs\"",
            "timeoutSec": 900
          }
        ]
      }
    ]
  }
}
